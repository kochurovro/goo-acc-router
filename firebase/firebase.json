{
  "firestore": { "rules": "firestore.rules" },
  "hosting": {
    "public": "public",
    "cleanUrls": true,
    "trailingSlash": false,
    "headers": [
      {
        "source": "**/*.xpi",
        "headers": [
          { "key": "Content-Type", "value": "application/x-xpinstall" },
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      }
    ]
  }
}
