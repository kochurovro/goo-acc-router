# Copy to .env and fill in. AMO keys: https://addons.mozilla.org/developers/addon/api/key/
WEB_EXT_API_KEY=
WEB_EXT_API_SECRET=

# Anonymous usage stats -> Firestore collection "pings". Firebase console -> Project settings -> General
# (Project ID, Web API key). Deploy firebase/firestore.rules first. Empty = stats off, no network requests.
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
